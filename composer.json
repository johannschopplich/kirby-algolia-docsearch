{
  "name": "johannschopplich/kirby-algolia-docsearch",
  "description": "Index and search your Kirby site with Algolia DocSearch",
  "type": "kirby-plugin",
  "version": "1.0.1",
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "algolia",
    "docsearch",
    "search"
  ],
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/kirby-algolia-docsearch#readme",
  "authors": [
    {
      "name": "Johann Schopplich",
      "email": "hello@johannschopplich.com",
      "homepage": "https://johannschopplich.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "getkirby/composer-installer": "^1",
    "algolia/algoliasearch-client-php": "^3.4"
  },
  "require-dev": {
    "getkirby/cms": "^5"
  },
  "scripts": {
    "csfix": "@php tools/phpcs/vendor/bin/php-cs-fixer fix",
    "dist": "composer install --no-dev --optimize-autoloader"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "extra": {
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^5.0"
    }
  }
}
